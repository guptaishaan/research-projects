%% paperstyle.sty -- companion package for the ACDSA 2027 manuscript format.
%%
%% ACDSA 2027 (Int'l Conference on AI, Computer, Data Sciences and Applications)
%% uses the standard IEEE conference Word/LaTeX template: two-column, 10pt Times,
%% Roman-numeral section headings, "Fig. N." captions below figures, "TABLE N"
%% captions above tables, and numeric bracket citations. All of that layout comes
%% from `IEEEtran' with the `conference' option, so this file only supplies the
%% extra packages and macros the manuscript bodies use.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{paperstyle}[2026/08/09 ACDSA 2027 manuscript companion]

% ---------------------------------------------------------------- floats/tables
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{multirow}
\RequirePackage{array}
\RequirePackage{float}

% ---------------------------------------------------------------- math
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{bm}
% indicator function; doublestroke ships a Type1 face, unlike bbm
\RequirePackage{dsfont}
\newcommand{\ind}{\mathds{1}}

% ---------------------------------------------------------------- lists
\RequirePackage{enumitem}

% ---------------------------------------------------------------- links/refs
% IEEEtran does not load hyperref itself; cleveref must come after it.
\RequirePackage[hidelinks,breaklinks=true]{hyperref}
\RequirePackage[capitalise,noabbrev]{cleveref}

% ---------------------------------------------------------------- keywords
% The ACDSA template's run-in head is "Keywords" (italic, em-dash), not
% IEEEtran's own default "Index Terms".
\newcommand{\paperkeywords}[1]{\textit{Keywords---#1}}

% ---------------------------------------------------------------- author block
% Every student author carries the same equal-contribution mark. The first
% student uses \equalcontrib, which both prints the star and creates the
% shared footnote; the rest repeat the mark with \equalcontribmark. This is
% the same fnsymbol-footnote idiom IEEE papers commonly use for author notes.
\newcommand{\equalcontrib}{\textsuperscript{*}%
  \begingroup\renewcommand{\thefootnote}{\fnsymbol{footnote}}%
  \footnote{These authors contributed equally to this work.}\endgroup}
\newcommand{\equalcontribmark}{\textsuperscript{*}}

% Several papers here carry 8-10 authors. Each \IEEEauthorblockN/A pair is its
% own independent mini table, sized to its OWN widest line and then joined to
% its neighbours by a zero-natural-width \hfill; once the row's total content
% exceeds \textwidth that glue collapses to zero and adjacent blocks visibly
% touch (worst case: two unbroken e-mail addresses run together with no gap).
% \@IEEEauthorblockAstyle/\@IEEEauthorblockNstyle hard-code \normalsize
% internally, so a \footnotesize set before \author{...} has no effect --
% these two must be overridden directly.
\let\IEEEoldauthorblockNstyle\@IEEEauthorblockNstyle
\let\IEEEoldauthorblockAstyle\@IEEEauthorblockAstyle
\renewcommand{\@IEEEauthorblockNstyle}{\IEEEoldauthorblockNstyle\footnotesize}
\renewcommand{\@IEEEauthorblockAstyle}{\IEEEoldauthorblockAstyle\footnotesize}

\endinput
